# .gitignore for Swift Package

# Swift Package Manager
/.build
/Packages
/*.xcodeproj
xcuserdata/
DerivedData/

# Xcode
.DS_Store
*.xcuserstate
*.xcworkspace

# Build artifacts
*.o
*.a
*.so
*.dylib
*.framework
*.xcframework

# SQLite build files (keep only the package structure)
/bld/
/ios_build/
Makefile
config.log
*.mk

# Docker
Dockerfile*
.dockerignore

# Temporary files
*.tmp
*.log
/data/

# Keep the SPM structure
!/Sources/
!/Tests/
!Package.swift
!README.md
# Temporary files
*.sqlite
*.db
mydb.*

# Documentation status files
GITHUB_SUCCESS.md
MASTER_BRANCH_READY.md
PUSH_TO_GITHUB.md
DOCKER_SETUP_SUMMARY.md

# Docker temporary files
docker-compose.override.yml
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Build artifacts
*.dSYM/
*.a
*.o

